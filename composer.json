{
	"name": "blockera/pro",
	"description": "The Premium Advanced Mode for Block Editor",
	"type": "library",
	"license": "ISC",
	"repositories": [
		{
			"type": "path",
			"url": "./packages/auth-pro"
		},
		{
			"type": "path",
			"url": "./packages/blockera-pro"
		},
		{
			"type": "path",
			"url": "./packages/blockera-pro-admin"
		},
		{
			"type": "path",
			"url": "./packages/guard"
		},
		{
			"type": "path",
			"url": "./packages/dev-phpunit"
		},
		{
			"type": "path",
			"url": "./packages/utils"
		}
	],
	"authors": [
		{
			"name": "blockeraai.com"
		}
	],
	"minimum-stability": "dev",
	"require": {
		"php": ">=7.4",
		"blockera/auth-pro": "*",
		"blockera/guard": "*",
		"blockera/blockera-pro": "*",
		"blockera/blockera-pro-admin": "*",
		"blockera/utils": "*",
		"vlucas/phpdotenv": "^5.6@dev",
		"league/oauth2-client": "dev-master"
	},
	"require-dev": {
		"blockera/dev-phpunit": "*",
		"symfony/dom-crawler": "5.4.x-dev",
		"symfony/css-selector": "5.4.x-dev",
		"voku/simple_html_dom": "dev-master",
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.5.21",
		"squizlabs/php_codesniffer": "^3.5",
		"wp-cli/wp-cli-bundle": "^2.4",
		"wp-coding-standards/wpcs": "^2.1",
		"wp-phpunit/wp-phpunit": "dev-master",
		"filp/whoops": "^2.15",
		"yoast/phpunit-polyfills": "^2.0@dev",
		"symfony/var-dumper": "5.4.x-dev",
		"brain/monkey": "^2.0@dev",
		"mockery/mockery": "1.7.x-dev"
	},
	"config": {
		"process-timeout": 0,
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"cweagans/composer-patches": true
		}
	}
}
