{
	"name": "@blockera/pro",
	"version": "1.1.1",
	"description": "The Premium Advanced Mode for Block Editor",
	"main": "packages/global-packages/packages/blockera-pro/js/index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/blockeraai/blockera-pro.git"
	},
	"keywords": [
		"blockera-pro"
	],
	"author": "blockeraai.com",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/blockeraai/blockera-pro/issues"
	},
	"homepage": "https://github.com/blockeraai/blockera-pro#readme",
	"engines": {
		"node": ">=20.19.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"refactor:validation": "node packages/global-packages/packages/console-pro/js/commands/validation/command.js [packages/global-packages/packages/guard-pro/js/editor/index.js, packages/global-packages/packages/editor-pro/js/extensions/libs/block-states/index.js, packages/global-packages/packages/controls-pro/js/index.js, packages/global-packages/packages/validator-pro/js/validate-secret-keys.js]",
		"build": "npm run refactor:validation && wp-scripts build --progress --mode production",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style packages/**/*.scss",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:php": "composer run lint",
		"update:changelogs": "node ./bin/plugin/cli.js update-packages-changelog",
		"plugin-zip": "wp-scripts plugin-zip",
		"project:bootstrap": "node packages/global-packages/packages/dev-tools/js/bootstrap/bootstrap-project.js --project=blockera-pro",
		"project:bootstrap:watch": "npm run project:bootstrap -- --watch",
		"start": "npm run project:bootstrap:watch -- -- wp-scripts start --mode development",
		"start:debug": "DEBUG_MODE=on wp-scripts start --progress",
		"clean": "rm -rf build dist/* node_modules vendor wordpress",
		"prepare": "husky install",
		"flow": "npx flow check",
		"typecheck": "tsc --noEmit",
		"setup": "npm install && npm run build",
		"test:e2e": "NODE_OPTIONS=--max_old_space_size=4096 npx cypress run --config video=false --browser chrome",
		"test:ct": "NODE_OPTIONS=--max_old_space_size=4096 npx cypress run --component",
		"test:ct:debug": "npx cypress open --component",
		"test:e2e:debug": "npx cypress open --e2e",
		"test:e2e:headed": "npm run test:e2e --headed",
		"test:e2e:record": "npx cypress run --browser chrome",
		"submodule:bump": "bash packages/global-packages/packages/dev-tools/github/scripts/bump-global-packages-submodule.sh",
		"test:js": "wp-scripts test-unit-js --config ./jest.config.js",
		"test:js:watch": "wp-scripts test-unit-js --config ./jest.config.js --watch",
		"test:js:coverage": "wp-scripts test-unit-js --config ./jest.config.js --coverage",
		"test:js:update": "npm run test:js -u",
		"test:generate-output": "jest --json --outputFile=.jest-test-results.json",
		"test:generate-output:dev": "jest --json --outputFile=.jest-test-results.json -- --watch",
		"test:unit:php:setup": "npm run env:start",
		"test:unit:php:base": "wp-env run --env-cwd='wp-content/plugins/blockera-pro' tests-wordpress vendor/bin/phpunit -c phpunit.xml.dist --verbose",
		"test:unit:php": "npm-run-all test:unit:php:setup test:unit:php:base",
		"test:unit:php:composer": "composer run-script test",
		"version": "grunt version && grunt update-pot",
		"icons:indexing": "node packages/global-packages/packages/dev-tools/bin/create-icon-search-index.js",
		"env": "wp-env",
		"env:stop": "npm run env stop",
		"env:start": "node packages/global-packages/packages/dev-tools/github/scripts/setup-wp-env.js && wp-env start",
		"env:reset": "npm run env:start --update --xdebug",
		"env:clean": "npm run env clean all",
		"env:destroy": "npm run env destroy",
		"env:tests-cli:bash": "npm run env run tests-cli bash",
		"packages:update": "wp-scripts packages-update",
		"plugin:activate": "wp-env run tests-cli wp plugin activate blockera-pro",
		"plugin:deactivate": "wp-env run tests-cli wp plugin deactivate blockera-pro"
	},
