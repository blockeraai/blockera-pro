		],
		"*.{js,ts,tsx}": [
			"npm run lint:js"
		],
		"*.scss": [
			"npm run lint:css"
		],
		"*.php": [
			"./bin/phpcs.sh --report-full --report-checkstyle=./.cache/phpcs-report.xml --standard=phpcs.xml"
		]
	},
