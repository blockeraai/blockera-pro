	"lint-staged": {
		"*.{js,json,ts,tsx,yml,yaml}": [
			"wp-scripts format"
		],
		"*.{js,ts,tsx}": [
			"npm run lint:js"
		],
		"*.scss": [
			"npm run lint:css"
		],
		"*.php": [
			"./vendor/bin/phpcs --report-full --report-checkstyle=./.cache/phpcs-report.xml --standard=phpcs.xml"
		]
	},
	"wp-env": {
		"plugin-dir": "blockera-pro",
		"plugin-name": "Blockera PRO",
		"welcome-build-command": "npm run dev"
	}
}
