# Edit packages/global-packages/packages/dev-tools/root-configs/phpstan.neon
# Extra excludePaths are generated from composer.json require and require-dev
# (blockera/*). project:bootstrap rewrites this file.
includes:
	- packages/global-packages/packages/dev-tools/php/phpstan.neon
parameters:
	excludePaths:
		analyse:
			- %currentWorkingDirectory%/packages/global-packages/packages/console-pro
			- %currentWorkingDirectory%/packages/global-packages/packages/controls-pro
			- %currentWorkingDirectory%/packages/global-packages/packages/site-toolkit
