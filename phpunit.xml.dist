<!--
	Pro-specific PHPUnit config (__BLOCKERA_DIR__ / suites).
	Do not replace with dev-tools/php/phpunit.plugin.xml.dist (core plugin suites).
	@see https://github.com/wp-phpunit/docs
-->
<phpunit
        bootstrap="./packages/global-packages/packages/dev-phpunit/php/bootstrap.php"
        backupGlobals="false"
        colors="true"
        convertErrorsToExceptions="true"
        convertNoticesToExceptions="true"
        convertWarningsToExceptions="true"
>
    <coverage>
        <report>
            <html outputDirectory="php-coverage" />
        </report>
    </coverage>

    <testsuites>
        <testsuite name="units">
            <directory suffix="Test.php">./packages/global-packages/packages/blockera-pro/php/tests/</directory>
            <directory suffix="Test.php">./packages/global-packages/packages/wordpress/php/tests/Admin/</directory>
            <directory suffix="Test.php">./packages/global-packages/packages/auth-pro/php/tests/</directory>
            <directory suffix="Test.php">./packages/global-packages/packages/autoloader-coordinator/php/tests/</directory>
            <directory suffix="Test.php">./packages/global-packages/packages/products/php/tests/</directory>
            <exclude>./node_modules/</exclude>
            <exclude>./dist/</exclude>
            <exclude>./packages/global-packages/packages/autoloader-coordinator/php/tests/TestCase.php</exclude>
            <exclude>./packages/global-packages/packages/autoloader-coordinator/php/tests/fixtures/</exclude>
            <exclude>./packages/global-packages/packages/products/php/tests/TestCase.php</exclude>
        </testsuite>
    </testsuites>

    <php>
        <env name="VERSION" value="1.0-beta" />
        <const name="PHPUNIT_PLUGIN_TEST" value="true"/>
        <env name="__BLOCKERA_DIR__" value="blockera-pro" />
        <env name="WP_PHPUNIT__TESTS_CONFIG" value="./packages/global-packages/packages/dev-phpunit/php/config.php" />
        <env name="WP_TESTS_CONFIG_FILE_PATH" value="./packages/global-packages/packages/dev-phpunit/php/config.php" />
    </php>

</phpunit>
