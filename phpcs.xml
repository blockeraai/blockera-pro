<?xml version="1.0"?>
<!-- Generated from composer.json require and require-dev (blockera/*) plus autoloader-coordinator. -->
<!-- project:bootstrap rewrites this file. -->
<ruleset name="WordPress Coding Standards for blockera-pro">
    <description>Consumer ruleset: shared Blockera PHPCS + blockera-pro text_domain. Scan the GP packages tree; exclude undeclared packages.</description>

    <rule ref="./packages/global-packages/packages/dev-tools/php/phpcs.xml"/>

    <config name="text_domain" value="blockera-pro,blockera,default"/>
    <file>./packages/global-packages/packages</file>
    <exclude-pattern>./packages/global-packages/packages/(blockera|blockera-admin|blockera-one|blocks-pro/core|console-pro|controls-pro|global-styles-ui|site-toolkit|validator-pro)/*</exclude-pattern>

    <arg name="cache" value=".cache/phpcs.json"/>
</ruleset>
