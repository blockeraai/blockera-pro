<?xml version="1.0"?>
<!-- Edit packages/global-packages/packages/dev-tools/root-configs/phpcs.blockera-pro.xml -->
<!-- project:bootstrap copies this to the host repo root for the blockera-pro project and fills the project id. -->
<ruleset name="WordPress Coding Standards for blockera-pro">
    <description>Consumer ruleset: shared Blockera PHPCS + blockera-pro text_domain and scan roots.</description>

    <rule ref="./packages/global-packages/packages/dev-tools/php/phpcs.xml"/>

    <config name="text_domain" value="blockera-pro,blockera,default"/>
    <file>./packages</file>

    <exclude-pattern>*/packages/[^/]*-one/</exclude-pattern>
    <exclude-pattern>*/packages/[^/]*-one-[^/]+/</exclude-pattern>
    <exclude-pattern>*/packages/[^/]*-toolkit/</exclude-pattern>
    <exclude-pattern>*/packages/[^/]*-toolkit-[^/]+/</exclude-pattern>

    <arg name="cache" value=".cache/phpcs.json"/>
</ruleset>
